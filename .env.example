# Copy this file to .env and fill in the sensitive values. The .env file is ignored by git.

# Application
MONGODB_CONNECTION_STRING=mongodb://root:example@mongo:27017/
DATABASE_NAME=excelbotcs
DISCORD_CONFIG={"Token":"REPLACE_WITH_DISCORD_TOKEN"}
LOTTERY_CHANNEL=1274793943950692393
EVENT_ENDPOINT_URL=localhost:8080

# MongoDB
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example

# mongo-express
ME_CONFIG_MONGODB_URL=mongodb://root:example@mongo:27017/
ME_CONFIG_BASICAUTH_ENABLED=true
ME_CONFIG_BASICAUTH_USERNAME=mongoexpressuser
ME_CONFIG_BASICAUTH_PASSWORD=mongoexpresspass

# Lottery automation (spec §7). `Enabled` is the deployment kill switch for the scheduler and `DryRun` posts the
# announcement with a [DRY RUN] prefix to the log channel instead of live. Base pot and weekly increment are
# deployment config: the admin page can change the schedule and templates, never these two. Environment variables
# beat appsettings.json, and the `__` separator maps to a section — keep the JSON's exact casing for nested keys
# (AGENTS.md). Cutover order (indexes, manual seed, backfill, dry-run week, promote) and the rollback:
# docs/lottery/cutover-runbook.md.
Lottery__Automation__Enabled=false
Lottery__Automation__DryRun=true
Lottery__Automation__BasePot=1000000
Lottery__Automation__WeeklyIncrement=1000000

# Public base URL used in links the bot posts (history page, admin failures). Falls back to Jwt:Issuer when unset.
WebBaseUrl=https://localhost:8080
